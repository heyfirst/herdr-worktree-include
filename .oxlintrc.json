{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/"],
  "plugins": ["typescript", "unicorn"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "unknown": {
            "message": "parse with a valibot schema or narrow the type"
          },
          "null": {
            "message": "no null: use a tagged union"
          },
          "undefined": {
            "message": "no undefined: use a tagged union, handle outside undefined on the same line"
          }
        }
      }
    ],
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-floating-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/no-null": "error",
    "eslint/no-undefined": "error"
  },
  "overrides": [
    {
      "files": ["src/core/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "bun", "bun:*", "../io/*"],
                "message": "src/core is pure: no I/O. Do it in src/io and pass the result in"
              }
            ]
          }
        ],
        "eslint/no-restricted-globals": [
          "error",
          {
            "name": "Bun",
            "message": "src/core is pure: no I/O"
          },
          {
            "name": "process",
            "message": "src/core is pure: read argv and env in main.ts"
          }
        ]
      }
    },
    {
      "files": ["src/core/**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off",
        "eslint/no-restricted-globals": "off"
      }
    }
  ]
}
