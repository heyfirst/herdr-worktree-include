{
  "name": "herdr-worktree-include",
  "private": true,
  "description": "herdr plugin that copies .worktreeinclude files into new worktrees. Built with Bun.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyfirst/herdr-worktree-include.git"
  },
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc --noEmit && oxlint --type-aware && oxfmt --check && bun test && bun run build",
    "build": "bun build src/main.ts --target bun --minify --outfile dist/main.js"
  },
  "dependencies": {
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  }
}
